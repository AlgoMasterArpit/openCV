# Copy to .env. Never commit .env.

# Leave empty on AWS (the instance role is used). Point at moto for offline laptop runs.
AWS_ENDPOINT_URL=http://localhost:5000
AWS_REGION=us-east-1
TABLE_NAME=metermind
BUCKET_NAME=metermind-photos

MODELS_DIR=models
# Set to the URL of a separate vision service (e.g. a COOL host); empty runs vision in-process.
VISION_URL=

# gemini | bedrock | none (none = rules only)
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Real AWS credentials profile, only needed on a laptop for LLM_PROVIDER=bedrock.
AWS_PROFILE=

PUBLIC_BASE_URL=http://localhost:8000
